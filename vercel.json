{
  "version": 2,
  "framework": null,
  "installCommand": "",
  "buildCommand": "curl -fsSL https://github.com/getzola/zola/releases/download/v$ZOLA_VERSION/zola-v$ZOLA_VERSION-x86_64-unknown-linux-musl.tar.gz | tar -xz -C /tmp zola && /tmp/zola build",
  "outputDirectory": "public",
  "build": {
    "env": {
      "ZOLA_VERSION": "0.23.6"
    }
  },
  "headers": [
    {
      "source": "/css/(.*).css",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/js/(.*).js",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
